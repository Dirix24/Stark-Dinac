{
  "name": "stark-os",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx tests/core.test.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "build:desktop": "tsc --noEmit && vite build --config apps/desktop/vite.config.mjs",
    "desktop": "npm run build:desktop && electron apps/desktop/main.mjs",
    "package:linux": "npm run build:desktop && sh scripts/package-linux.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/three": "^0.187.0",
    "electron": "^40.10.2",
    "eslint": "^10",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vite": "^6.4.6"
  }
}
